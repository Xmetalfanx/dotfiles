palette = "mycolors"

[palettes.mycolors]
bg_dark     = "#333333"
neon_green  = "#12BB02"
blue        = "#1144AB"
blue_dim    = "#1C3A5E"
yellow      = "#FCF392"
text        = "#E4E4E4"
red         = "#E84D44"
teal        = "#8DFBD2"
white       = "#FFFFFF"


format = """\
[ ](bg:bg_dark fg:neon_green)
[ ](bg:bg_dark fg:white)
[](fg:white bg:bg_dark)
$directory
[](fg:white bg:bg_dark)
$git_branch
$git_status
$character
"""

[directory]
format = "[  $path ]($style)"
style = "fg:text bg:blue"
truncate_to_repo = false
truncation_length = 2

[git_branch]
format = '[ $symbol$branch(:$remote_branch) ]($style)'
symbol = "  "
style = "bg:blue_dim fg:yellow"

[git_status]
format = '[$all_status]($style)'
style = "bg:blue_dim fg:yellow"

[cmd_duration]
format = "[  $duration ]($style)"
style = "fg:bright-white bg:18"

[character]
success_symbol = '[ ➜](bold green) '
error_symbol = '[ ✗](red) '

[package]
disabled = true

[nodejs]
disabled = true

[git_metrics]
disabled = true